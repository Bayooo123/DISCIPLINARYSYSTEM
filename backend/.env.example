# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tidds

# JWT
JWT_SECRET=replace_with_a_long_random_secret_minimum_64_chars
JWT_EXPIRES_IN=8h

# Server
PORT=4000
NODE_ENV=development

# Email (University SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@unilag.edu.ng
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME=University of Lagos Disciplinary System

# SMS — Termii
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=UNILAG

# File Storage (AWS S3 or compatible)
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_BUCKET_NAME=tidds-evidence
AWS_REGION=eu-west-1

# Platform Admin bootstrap (first run only)
PLATFORM_ADMIN_EMAIL=admin@tidds.io
PLATFORM_ADMIN_PASSWORD=change_immediately_on_first_login
