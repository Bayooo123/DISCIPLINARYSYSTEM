# Database
DATABASE_URL=postgresql://tidds:password@localhost:5432/tidds_db

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-minimum-64-chars-abcdefghijklmnopqrstuvwxyz1234
JWT_EXPIRES_IN=8h

# Reforma Admin credentials (NOT stored in DB — env only)
REFORMA_ADMIN_EMAIL=admin@reformadigital.com
REFORMA_ADMIN_PASSWORD=replace-before-deploy

# Email (platform SMTP fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@reformadigital.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=TIDDS Platform
EMAIL_FROM_ADDR=noreply@reformadigital.com

# SMS (Termii)
TERMII_API_KEY=your-termii-api-key
TERMII_BASE_URL=https://api.ng.termii.com/api
TERMII_DEFAULT_SENDER=TIDDS

# File Storage
STORAGE_MODE=local
LOCAL_UPLOAD_PATH=./uploads
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_BUCKET_NAME=tidds-uploads
AWS_REGION=eu-west-1

# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:5000/api
